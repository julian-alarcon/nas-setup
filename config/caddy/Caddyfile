# Dawarich
YOUR_DAWARICH_DOMAIN:35000 {
    import tls_13
    import security_headers
    import access_log
    encode zstd gzip

    header {
        Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    }

    reverse_proxy 192.168.1.200:30081
}

# Home Assistant (mTLS-protected)
YOUR_HA_DOMAIN:35000 {
    import client_mtls
    import tls_13
    import security_headers
    import access_log
    encode zstd gzip

    header {
        # HA legitimately uses geolocation/microphone/camera, so allow them (self)
        # instead of using the strict deny used on other apps.
        Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), interest-cohort=()"
    }

    reverse_proxy YOUR_HA_VM_IP:80
}
